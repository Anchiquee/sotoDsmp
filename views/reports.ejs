<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Gestión de Reportes</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="w-screen h-screen bg-gray-100 text-gray-900 flex flex-col">

  <!-- Contenido principal -->
  <main class="flex-grow flex flex-col p-6 overflow-hidden">
    <h2 class="text-3xl font-bold text-blue-700 mb-6 text-center">Gestión de Reportes</h2>

    <% if (user && user.role === 'admin') { %>
      <div class="mb-4 text-center">
        <a href="/dashboard/reports/create" class="bg-blue-700 px-4 py-2 rounded-lg text-white text-sm font-semibold hover:bg-blue-800">Crear Reporte</a>
      </div>
    <% } %>

    <!-- Contenedor de tarjetas -->
    <div class="flex-grow overflow-y-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% if (reports.length === 0) { %>
          <p class="col-span-full text-center text-lg text-gray-500">No hay reportes disponibles.</p>
        <% } else { %>
          <% reports.forEach(r => { %>
            <div class="bg-white p-4 shadow-md rounded-lg space-y-2 text-sm">
              <div class="cursor-pointer" onclick="toggleDetails('<%= r.id %>')">
                <p class="text-xl text-blue-600 font-bold"><%= r.title %></p>
                <p class="text-sm text-gray-600"><%= r.description %></p>
              </div>

              <!-- Detalles desplegables -->
              <div id="details-<%= r.id %>" class="hidden space-y-2">
                <% if (user && user.role === 'admin') { %>
                  <form action="/dashboard/reports/update/<%= r.id %>" method="POST" class="space-y-2">
                    <input name="title" value="<%= r.title %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Título" required />
                    <textarea name="description" class="w-full p-1 border border-gray-300 rounded" placeholder="Descripción"><%= r.description %></textarea>
                    <textarea name="db_query" class="w-full p-1 border border-gray-300 rounded" placeholder="Consulta SQL"><%= r.db_query %></textarea>
                    <input name="db_host" value="<%= r.db_host %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Host" required />
                    <input name="db_port" type="number" value="<%= r.db_port %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Puerto" required />
                    <input name="db_user" value="<%= r.db_user %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Usuario BD" required />
                    <input name="db_password" type="password" value="<%= r.db_password %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Contraseña" />
                    <input name="db_name" value="<%= r.db_name %>" class="w-full p-1 border border-gray-300 rounded" placeholder="Nombre BD" required />

                    <button class="bg-yellow-500 w-full text-white py-2 rounded hover:bg-yellow-600">Actualizar</button>
                  </form>
                  <a href="/dashboard/reports/delete/<%= r.id %>" class="mt-2 inline-block bg-red-500 text-white w-full text-center py-2 rounded hover:bg-red-600">Eliminar</a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Botón de volver al Dashboard -->
    <div class="mt-6 text-center">
      <a href="/dashboard" class="inline-block bg-gradient-to-r from-green-500 to-green-700 text-white py-3 px-6 rounded-lg font-semibold hover:opacity-90 transition">
        Volver al Dashboard
      </a>
    </div>

  </main>

  <!-- SweetAlert2 de confirmación -->
  <script>
    <% if (typeof message !== 'undefined') { %>
      Swal.fire({
        icon: 'success',
        title: '¡Éxito!',
        text: "<%= message %>",
        confirmButtonColor: '#3085d6',
        confirmButtonText: 'Aceptar'
      });
    <% } else if (typeof error !== 'undefined') { %>
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: "<%= error %>",
        confirmButtonColor: '#d33',
        confirmButtonText: 'Aceptar'
      });
    <% } %>

    // Función para alternar la visibilidad de los detalles de la tarjeta
    function toggleDetails(reportId) {
      const details = document.getElementById(`details-${reportId}`);
      details.classList.toggle('hidden');
    }
  </script>

</body>
</html>
