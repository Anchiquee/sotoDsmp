<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">

  <!-- Contenedor principal con barra lateral y contenido principal -->
  <div class="flex h-screen">

    <!-- Barra lateral -->
    <aside class="w-64 bg-gradient-to-r from-blue-600 to-blue-800 p-6 text-white rounded-lg shadow-xl flex flex-col">
      <h2 class="text-3xl font-bold mb-8 text-center">Envios Correos</h2>
      <ul class="space-y-6 flex-grow">
        <li>
          <a href="/dashboard/users" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-blue-500 hover:text-white border-2 border-transparent hover:border-blue-300">Usuarios</a>
        </li>
        <li>
          <a href="/dashboard/emails" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-blue-500 hover:text-white border-2 border-transparent hover:border-blue-300">Correos</a>
        </li>
        <li>
          <a href="/dashboard/reports" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-blue-500 hover:text-white border-2 border-transparent hover:border-blue-300">Reportes</a>
        </li>
        <li class="mb-2">
          <a href="/dashboard/send_reports" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-blue-500 hover:text-white border-2 border-transparent hover:border-blue-300">
            📩 Enviar Reportes
          </a>
        </li>
         <!-- Nuevo enlace para la configuración del correo -->
    <li>
      <a href="/dashboard/config_email" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-blue-500 hover:text-white border-2 border-transparent hover:border-blue-300">Configurar Correo</a>
    </li>
        <li>
          <a href="/auth/logout" class="block text-lg font-semibold px-4 py-2 rounded-md text-center transition-colors duration-200 hover:bg-red-500 hover:text-white border-2 border-transparent hover:border-red-300">Salir</a>
        </li>
        
      </ul>
      <div class="mt-auto text-center text-sm">
        <p>&copy; 2025 Envio Correos DMP Ericsson</p>
      </div>
    </aside>

    <!-- Contenido principal -->
    <div class="flex-1 p-6 overflow-auto">
      <h1 class="text-4xl font-semibold text-center text-blue-600 mb-6">Bienvenido al Dashboard</h1>
      
      <!-- Fecha y hora -->
      <h2 id="current-date" class="text-xl text-center text-gray-700 mb-8"></h2>

      <!-- Tarjetas de resumen -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <!-- Total de usuarios -->
        <div class="bg-white shadow-lg rounded-lg p-6 text-center">
          <h3 class="text-2xl font-bold text-blue-600"><%= totalUsers %></h3>
          <p class="text-gray-700 mt-2">Total Usuarios</p>
        </div>

        <!-- Total de correos -->
        <div class="bg-white shadow-lg rounded-lg p-6 text-center">
          <h3 class="text-2xl font-bold text-green-600"><%= totalEmails %></h3>
          <p class="text-gray-700 mt-2">Total Correos</p>
        </div>

        <!-- Total de reportes -->
        <div class="bg-white shadow-lg rounded-lg p-6 text-center">
          <h3 class="text-2xl font-bold text-red-600"><%= totalReports %></h3>
          <p class="text-gray-700 mt-2">Total Reportes</p>
        </div>

        <!-- Total de administradores -->
        <div class="bg-white shadow-lg rounded-lg p-6 text-center">
          <h3 class="text-2xl font-bold text-purple-600"><%= totalAdmins %></h3>
          <p class="text-gray-700 mt-2">Total Admins</p>
        </div>
      </div>

<!--hasta aca correo-->
    </div>
  </div>


  <!-- Pie de página -->
  <footer class="bg-gray-800 text-white text-center py-4 mt-auto">
    <p>&copy; 2025 Envio Correos DMP Ericsson</p>
  </footer>

  <!-- Script para actualizar la fecha y hora -->
  <script>
    // Función para actualizar la fecha y hora
    function updateDate() {
      const today = new Date();
      const hours = String(today.getHours()).padStart(2, '0');
      const minutes = String(today.getMinutes()).padStart(2, '0');
      const seconds = String(today.getSeconds()).padStart(2, '0');
      const formattedDate = today.toISOString().slice(0, 10).replace(/-/g, '');
      const formattedTime = `${hours}:${minutes}:${seconds}`;
      
      // Actualizar el texto del id "current-date"
      document.getElementById('current-date').textContent = `Fecha: ${formattedDate} | Hora: ${formattedTime}`;
    }

    // Llamar la función al cargar la página
    updateDate();

    // Actualizar cada segundo
    setInterval(updateDate, 1000);
  </script>

</body>
</html>
